# Host portal authentication (required)
HOST_EMAIL=
# Set these only in the deployment secret manager; never commit real values.
HOST_PASSWORD_HASH=salt:scrypt-hash-hex

# Protects POST /api/webhook/booking from anonymous requests.
BOOKING_WEBHOOK_SECRET=replace-with-a-long-random-secret

# Persistent server-side storage (Supabase project settings)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Public origin used to generate guest links
APP_URL=