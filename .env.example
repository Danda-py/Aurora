# ============================================================
# Aurora in Valtellina - Variabili d'ambiente
#
# Copia questo file in `.env` e compila i valori.
# Le variabili sono divise in:
#   1. RICHIESTE   - l'applicazione non funziona correttamente senza
#   2. OPZIONALI   - attivano funzionalità extra se impostate
#
# Tutte le variabili vengono lette dal codice (frontend + server);
# nessuna variabile obsoleta è inclusa in questo template.
# ============================================================

# ------------------------------------------------------------
# 1. RICHIESTE
# ------------------------------------------------------------

# URL pubblico dell'app, usato per costruire i link guest pass
# (es. https://aurora.example.com). In produzione su Vercel è essenziale:
# in locale il server usa automaticamente l'host della richiesta.
APP_URL=

# URL del progetto Supabase (server backend).
# Il server funziona anche senza Supabase (fallback su file JSON locali),
# ma in produzione (es. Vercel, filesystem effimero) è obbligatorio per
# la persistenza di pass, log attività e configurazioni.
# Usato anche come fallback dal client se VITE_SUPABASE_URL è assente.
SUPABASE_URL=

# Service role key di Supabase (server backend, accesso completo).
SUPABASE_SERVICE_ROLE_KEY=

# URL del progetto Supabase lato frontend (iniettato da Vite in build).
VITE_SUPABASE_URL=

# Nota: il codice accetta anche gli alias legacy NEXT_PUBLIC_SUPABASE_URL
# (come fallback di SUPABASE_URL) e SUPABASE_ANON_KEY (come fallback della
# service role key), ma non sono necessari se le variabili sopra sono impostate.

# Chiave anon di Supabase lato frontend (iniettata da Vite in build).
# Fallback server-side se SUPABASE_SERVICE_ROLE_KEY è assente.
VITE_SUPABASE_ANON_KEY=

# ------------------------------------------------------------
# 2. OPZIONALI - Autenticazione host
# ------------------------------------------------------------

# Email dell'account host. Se non impostata, viene usata quella
# salvata durante il bootstrap (data/host_account.json).
HOST_EMAIL=

# Password dell'host in chiaro oppure hash scrypt nel formato "salt:hash".
# Se assente, viene usato l'hash salvato al bootstrap.
# Preferire HOST_PASSWORD_HASH in produzione.
HOST_PASSWORD=

# Hash scrypt della password host (formato "salt:scrypt-hash-hex").
# Generabile con: node -e "const c=require('crypto');const s=c.randomBytes(16).toString('hex');console.log(s+':'+c.scryptSync('PASSWORD',s,64).toString('hex'))"
HOST_PASSWORD_HASH=

# Segreto per firmare le sessioni host (HMAC). Se assente viene derivato
# dall'hash della password; impostarlo esplicitamente invalida le sessioni
# al cambio password invece di mantenerle.
HOST_SESSION_SECRET=

# Segreto richiesto per il primo bootstrap dell'account host via API.
# Se vuoto, il bootstrap è aperto finché l'account non esiste.
HOST_BOOTSTRAP_SECRET=

# Ambiente di esecuzione: "production" abilita cookie Secure e rate limiting
# login, e serve il frontend dalla cartella dist/. In locale lasciare vuoto
# (o "development"): Vercel lo imposta automaticamente.
# NODE_ENV=production

# ------------------------------------------------------------
# 3. OPZIONALI - Webhook e sicurezza API
# ------------------------------------------------------------

# Segreto per autorizzare i webhook di prenotazione in entrata
# (POST /api/webhook/booking e /api/webhook/ireservation, header
# "x-booking-webhook-secret"). Se assente, solo la sessione host è valida.
BOOKING_WEBHOOK_SECRET=

# Segreto per il webhook di stato della serratura
# (POST /api/webhook/lock-status, header "x-lock-webhook-secret").
# Fallback automatico su BOOKING_WEBHOOK_SECRET se assente.
LOCK_WEBHOOK_SECRET=

# ------------------------------------------------------------
# 4. OPZIONALI - Smart Lock / Home Assistant
# ------------------------------------------------------------

# URL dell'istanza Home Assistant (es. http://192.168.1.50:8123).
# Impostandolo (con HASS_TOKEN) la modalità predefinita diventa "rest_api".
HASS_URL=

# Token di accesso a lungo termine di Home Assistant.
HASS_TOKEN=

# URL del webhook di sblocco (modalità "webhook", es. eWeLink/Sonoff).
# Fallback: EWELINK_WEBHOOK_URL.
HASS_WEBHOOK_URL=

# Alias legacy del webhook di sblocco (usato se HASS_WEBHOOK_URL è vuoto).
EWELINK_WEBHOOK_URL=

# Modalità di integrazione: "rest_api" oppure "webhook".
# Predefinito: "rest_api" se HASS_URL è impostata, altrimenti "webhook".
HASS_MODE=

# Entity da attivare in modalità rest_api (predefinito: switch.portone).
HASS_ENTITY_ID=

# Servizio Home Assistant da chiamare (predefinito: switch.turn_on).
HASS_SERVICE=

# Nome visualizzato del dispositivo (predefinito: Pulsante Portone Aurora).
HASS_DEVICE_NAME=

# ------------------------------------------------------------
# 5. OPZIONALI - AI (Aurora AI / traduzioni)
# ------------------------------------------------------------

# API key Google Gemini per Aurora AI chat (@google/genai).
# Senza chiave le funzioni AI rispondono con un fallback non-AI.
GEMINI_API_KEY=

# ------------------------------------------------------------
# 6. OPZIONALI - Alloggiati Web (comunicazione polizia)
# ------------------------------------------------------------

# Credenziali del portale Alloggiati Web.
ALLOGGIATI_USER=
ALLOGGIATI_PASSWORD=

# Chiave WSKey del servizio web Alloggiati.
ALLOGGIATI_WSKEY=

# ------------------------------------------------------------
# 7. OPZIONALI - Channel Manager / sincronizzazione iCal
# ------------------------------------------------------------

# URL iCal della piattaforma esterna (Booking, Airbnb, bed-and-breakfast.it...).
# Se impostata, abilita la sincronizzazione automatica dei canali.
ICAL_SYNC_URL=

# Intervallo di sincronizzazione in millisecondi (predefinito: 1800000 = 30 min).
ICAL_SYNC_INTERVAL_MS=

# Giorni di anticipo per l'invio del link ospite dopo la sincronizzazione
# (predefinito: 3).
ICAL_DAYS_AHEAD_SEND=

# ------------------------------------------------------------
# 8. OPZIONALI - Notifiche
# ------------------------------------------------------------

# Credenziali Twilio per invio SMS / WhatsApp all'host.
# WhatsApp: impostare TWILIO_WHATSAPP_FROM (es. "whatsapp:+393401234567");
# in alternativa TWILIO_FROM_NUMBER viene usato per WhatsApp.
# SMS: impostare TWILIO_SMS_FROM; in alternativa TWILIO_FROM_NUMBER senza
# il prefisso "whatsapp:".
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=
TWILIO_SMS_FROM=
TWILIO_FROM_NUMBER=

# Notifiche Telegram (alternative a Twilio).
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Webhook generico per notifiche host (POST JSON).
HOST_NOTIFICATION_WEBHOOK_URL=
