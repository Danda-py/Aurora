{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "vite build",
  "outputDirectory": "dist",
  "framework": "vite",
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/index"
    },
    {
      "source": "/host-portal",
      "destination": "/host-portal/index.html"
    },
    {
      "source": "/((?!api|host-portal|uploads).*)",
      "destination": "/index.html"
    }
  ]
}
